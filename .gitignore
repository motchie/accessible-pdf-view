node_modules/
.output/
.wxt/
stats.html
*.zip

# Generated by scripts/copy-assets.mjs from node_modules — do not commit them.
# (vendor/ is the exception on purpose: its binary is a build that is not on
# npm, so the repository is where it comes from.)
public/wasm/
public/pdfjs/
public/pdf-inspector/

# Nothing here ignores working material any more, because none of it is in this
# directory: the third-party test PDFs, the suites written around them, the
# design files, the original brief and the parked notes all live outside the
# repository. The documents written for this project are the exception, and are
# committed: see tests/fixtures/word/README.md.
#
# This one stays as insurance. Windows writes it beside a downloaded file and
# it records where the file came from (`ReferrerUrl=`), so a stray one would
# publish the source of a document this project deliberately does not name.
*:Zone.Identifier

# Written by `wxt submit init`. Store credentials; the CI copies live in the
# `chrome-web-store` environment on GitHub.
.env.submit

# Word's lock file beside an open document, such as a fixture's .docx.
~$*
